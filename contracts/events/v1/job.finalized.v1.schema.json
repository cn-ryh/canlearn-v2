{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.canlearn.invalid/events/job.finalized.v1",
  "title": "job.finalized.v1",
  "$comment": "CL-008 proposal; no live producer/consumer or authorization guarantee",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_revision",
    "space_id",
    "actor_ref",
    "trace_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "job.finalized.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "job"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "space_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_ref": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "input_snapshot_id",
        "status",
        "admission_epoch",
        "result_refs",
        "cost_state",
        "failure_code"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "input_snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": ["PARTIAL_READY", "SUCCEEDED", "FAILED", "CANCELLED"]
        },
        "admission_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_ref"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "cost_state": {
          "enum": ["reserved", "observed", "unknown_pending_reconciliation", "reconciled"]
        },
        "failure_code": {
          "enum": [
            null,
            "PERMANENT_ERROR",
            "VERSION_CONFLICT",
            "UPSTREAM_UNKNOWN",
            "QUALITY_NOT_READY",
            "REVIEW_DEADLINE",
            "BUDGET_EXHAUSTED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PARTIAL_READY"
              }
            }
          },
          "then": {
            "properties": {
              "result_refs": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "failure_code": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id", "version_id"],
      "properties": {
        "resource_type": {
          "enum": [
            "document",
            "source_version",
            "content_revision",
            "question_version",
            "explanation_version",
            "index_generation",
            "evidence_version",
            "plan_version",
            "export_version"
          ]
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
