{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.canlearn.invalid/events/resource.invalidated.v1",
  "title": "resource.invalidated.v1",
  "$comment": "CL-008 proposal; no live producer/consumer or authorization guarantee",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_revision",
    "space_id",
    "actor_ref",
    "trace_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "resource.invalidated.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "resource"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "space_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_ref": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_refs",
        "reason_code",
        "resource_revision",
        "deletion_case_id",
        "deletion_watermark"
      ],
      "properties": {
        "resource_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_ref"
          },
          "maxItems": 32,
          "uniqueItems": true,
          "minItems": 1
        },
        "reason_code": {
          "enum": ["corrected", "withdrawn", "deleted", "access_revoked"]
        },
        "resource_revision": {
          "type": "integer",
          "minimum": 1
        },
        "deletion_case_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "deletion_watermark": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason_code": {
                "const": "deleted"
              }
            }
          },
          "then": {
            "properties": {
              "deletion_case_id": {
                "type": "string",
                "format": "uuid"
              },
              "deletion_watermark": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "deletion_case_id": {
                "type": "null"
              },
              "deletion_watermark": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id", "version_id"],
      "properties": {
        "resource_type": {
          "enum": [
            "document",
            "source_version",
            "content_revision",
            "question_version",
            "explanation_version",
            "index_generation",
            "evidence_version",
            "plan_version",
            "export_version"
          ]
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
