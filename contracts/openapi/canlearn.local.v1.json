{
  "openapi": "3.1.0",
  "info": {
    "title": "CanLearn local parse API",
    "version": "1.0.0",
    "description": "CL-105 local isolated parse slice: explicit local-only runtime scope, synthetic page results, no production session or resource authorization.",
    "license": {
      "name": "Proprietary",
      "identifier": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "local-parse",
      "description": "默认关闭、仅回环、仅合成夹具的本地解析切片"
    }
  ],
  "paths": {
    "/v1/local/parse-jobs": {
      "post": {
        "operationId": "createLocalParseJob",
        "summary": "创建本地隔离解析 Job",
        "tags": ["local-parse"],
        "security": [],
        "x-implementation-status": "implemented",
        "x-runtime-scope": "local-isolated-only",
        "responses": {
          "202": {
            "description": "任务已持久受理",
            "headers": {
              "Location": {
                "description": "本地 Job 查询地址",
                "schema": {
                  "type": "string",
                  "pattern": "^/v1/local/jobs/[0-9a-f-]{36}$"
                }
              },
              "Idempotency-Replayed": {
                "description": "同键同载荷重放时出现",
                "schema": {
                  "type": "string",
                  "enum": ["true"]
                }
              },
              "ETag": {
                "description": "当前 Job 视图的强实体标签",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseJob"
                }
              }
            }
          },
          "400": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "403": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "409": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "422": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "503": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Smoke-Client",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["1"]
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLocalParseJob"
              }
            }
          }
        }
      }
    },
    "/v1/local/jobs/{jobId}": {
      "get": {
        "operationId": "getLocalParseJob",
        "summary": "查询本地隔离解析 Job",
        "tags": ["local-parse"],
        "security": [],
        "x-implementation-status": "implemented",
        "x-runtime-scope": "local-isolated-only",
        "responses": {
          "200": {
            "description": "当前本地解析任务",
            "headers": {
              "Cache-Control": {
                "description": "私有业务响应不可缓存",
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              },
              "ETag": {
                "description": "当前 Job 视图的强实体标签",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseJob"
                }
              }
            }
          },
          "400": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "403": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "404": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v1/local/jobs/{jobId}/cancel": {
      "post": {
        "operationId": "cancelLocalParseJob",
        "summary": "取消本地隔离解析 Job",
        "tags": ["local-parse"],
        "security": [],
        "x-implementation-status": "implemented",
        "x-runtime-scope": "local-isolated-only",
        "responses": {
          "200": {
            "description": "当前本地解析任务",
            "headers": {
              "Cache-Control": {
                "description": "私有业务响应不可缓存",
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              },
              "ETag": {
                "description": "当前 Job 视图的强实体标签",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseJob"
                }
              }
            }
          },
          "400": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "403": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          },
          "404": {
            "description": "请求被拒绝或服务暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalParseError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "X-Smoke-Client",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["1"]
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateLocalParseJob": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "versionId", "sourceRevision", "profileId", "fixture"],
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string",
            "enum": ["local-synthetic-v1"]
          },
          "fixture": {
            "type": "string",
            "enum": ["success", "partial", "blank", "fail", "pending"]
          },
          "all": {
            "type": "boolean",
            "enum": [true]
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          }
        }
      },
      "LocalParseJob": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "snapshotId",
          "traceId",
          "documentId",
          "versionId",
          "sourceRevision",
          "profileId",
          "fixture",
          "requestedPages",
          "pageResults",
          "revision",
          "epoch",
          "terminationState",
          "failureCode",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": ["local_parse"]
          },
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "WAITING_REVIEW",
              "PARTIAL_READY",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "snapshotId": {
            "type": "string",
            "format": "uuid"
          },
          "traceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string",
            "enum": ["local-synthetic-v1"]
          },
          "fixture": {
            "type": "string",
            "enum": ["success", "partial", "blank", "fail", "pending"]
          },
          "requestedPages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "pageResults": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pageIndex", "status"],
                  "properties": {
                    "pageIndex": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 6
                    },
                    "status": {
                      "enum": ["success", "blank", "failed", "missing"]
                    }
                  }
                }
              }
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "epoch": {
            "type": "integer",
            "minimum": 1
          },
          "terminationState": {
            "type": "string",
            "enum": ["not_requested", "requested", "confirmed"]
          },
          "failureCode": {
            "enum": [null, "PERMANENT_ERROR"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LocalParseError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statusCode", "message", "error"],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
