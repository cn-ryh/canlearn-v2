NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
API_INTERNAL_URL=http://localhost:3001/v1
CORS_ORIGIN=http://localhost:3000

# Docker Hub mirror; use docker.io to access the upstream registry directly.
CANLEARN_DOCKERHUB_REGISTRY=jjs7iczbx3i38wpthb.xuanyuan.run

POSTGRES_DB=canlearn
POSTGRES_USER=canlearn
POSTGRES_PASSWORD=canlearn_local
DATABASE_URL=postgresql://canlearn:canlearn_local@localhost:5432/canlearn
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal_local
REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=canlearn-workflows
MINERU_BASE_URL=http://localhost:8000

# CL-013a synthetic routes/workflows are absent unless explicitly enabled.
# Use the isolated launcher in docs/integration/CL-013a; never put its service token in NEXT_PUBLIC_*.
CANLEARN_SMOKE_ENABLED=false
CANLEARN_SMOKE_TOKEN=
CANLEARN_SMOKE_ORIGIN=http://127.0.0.1:3310
CANLEARN_SMOKE_API_URL=http://127.0.0.1:3311/v1
