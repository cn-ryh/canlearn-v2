{"metadata": {"file_suffix": "pdf", "producer": {"name": "mineru", "version": "4.0.7"}, "document": {"title": "D03-reading-v1", "authors": ["CanLearn original synthetic benchmark fixture"], "subject": "unspecified", "created_at": "2000-01-01T00:00:00+00:00", "modified_at": "2000-01-01T00:00:00+00:00", "creator_application": "ReportLab PDF Library - www.reportlab.com", "producer_application": "ReportLab PDF Library - www.reportlab.com", "page_count": 2, "page_count_kind": "physical"}}, "extensions": {"mineru": {"tier": "flash", "parse_mode": "txt"}, "docvortex_layout": {"version": 1, "pages": [{"page_idx": 0, "width_pt": 595.2755737304688, "height_pt": 841.8897705078125}, {"page_idx": 1, "width_pt": 595.2755737304688, "height_pt": 841.8897705078125}]}}, "pages": [{"page_idx": 0, "blocks": [{"type": "header", "index": 0, "bbox": [0.067, 0.038, 0.374, 0.057], "content": [{"type": "text", "content": "D03-reading-v1 / PDF page 1"}]}, {"type": "header", "index": 1, "bbox": [0.067, 0.066, 0.4, 0.08], "content": [{"type": "text", "content": "原创合成测试资料 / 非真题、非正式教学内容"}]}, {"type": "text", "index": 2, "bbox": [0.067, 0.117, 0.897, 0.134], "content": [{"type": "text", "content": "[E1] Lina studies at a fictional campus library on Tuesday and Thursday, from 18:00 to 19:00."}]}, {"type": "text", "index": 3, "bbox": [0.067, 0.171, 0.914, 0.211], "content": [{"type": "text", "content": "[E2] She studies vocabulary on Tuesday and reads science articles on Thursday. She does not study at the library on Friday."}]}, {"type": "footer", "index": 4, "bbox": [0.067, 0.943, 0.559, 0.955], "content": [{"type": "text", "content": "Font subset: Droid Sans Fallback; Apache-2.0 notices accompany corpus"}]}]}, {"page_idx": 1, "blocks": [{"type": "header", "index": 0, "bbox": [0.067, 0.038, 0.374, 0.057], "content": [{"type": "text", "content": "D03-reading-v1 / PDF page 2"}]}, {"type": "header", "index": 1, "bbox": [0.067, 0.066, 0.4, 0.08], "content": [{"type": "text", "content": "原创合成测试资料 / 非真题、非正式教学内容"}]}, {"type": "text", "index": 2, "bbox": [0.067, 0.117, 0.835, 0.134], "content": [{"type": "text", "content": "[E3] Her study partner Omar arrives on Thursday at 18:30 and stays for thirty minutes."}]}, {"type": "text", "index": 3, "bbox": [0.067, 0.171, 0.924, 0.211], "content": [{"type": "text", "content": "[E4] They check unfamiliar words in the article before discussing its main idea. The text gives no exam score or learning-effect estimate."}]}, {"type": "footer", "index": 4, "bbox": [0.067, 0.943, 0.559, 0.955], "content": [{"type": "text", "content": "Font subset: Droid Sans Fallback; Apache-2.0 notices accompany corpus"}]}]}], "is_full_document": true, "schema": "docvortex.middle", "schema_version": "2.0"}