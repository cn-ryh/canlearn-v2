      "id": "F01-network-retransmission",
      "actions": [
        {
          "op": "submit"
        },
        {
          "op": "submit"
        },
        {
          "op": "submit"
        }
      ],
      "expected": {
        "job_count": 1,
        "calls": 0,
        "outbox_count": 1
      }
    },
    {
      "id": "F02-request-key-conflict",
      "actions": [
        {
          "op": "submit"
        },
        {
          "op": "submit",
          "pages": [1, 2],
          "reject": "IDEMPOTENCY_CONFLICT"
        }
      ],
      "expected": {
        "job_count": 1
      }
    },
    {
      "id": "F03-request-scope-isolation",
